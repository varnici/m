# Shared
ENV=dev
LOG_LEVEL=info

# Runtime (dev enables X-User-Id auth fallback for Supabase mobile clients)
ENV=dev

# Database
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ventureroot
POSTGRES_USER=ventureroot
POSTGRES_PASSWORD=ventureroot

# Redis
REDIS_URL=redis://redis:6379/0

# Auth (stubbed)
JWT_ISSUER=ventureroot
JWT_AUDIENCE=ventureroot-mobile
JWT_SECRET=dev-secret-change-me

# Internal service URLs (docker-compose)
CORE_BANKING_URL=http://core-banking:8001
AI_ML_URL=http://ai-ml-service:8002
RAG_URL=http://rag-service:8003
USSD_URL=http://ussd-service:8004

# ── Supabase ──────────────────────────────────────────────────────────────────
# Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here   # service_role secret (NOT anon key)

# Supabase Dashboard → Project Settings → Database → Connection string (URI, "Session pooler" mode)
# Required for the worker dashboard/investment module — it reads public.profiles,
# public.savings_plans, public.investments etc. directly, and those tables live in
# Supabase's Postgres, not the local `ventureroot` DB below. Without this set, the
# worker dashboard silently returns empty data for every user.
SUPABASE_DATABASE_URL=postgresql+psycopg2://postgres.your-project:your-db-password@aws-0-region.pooler.supabase.com:5432/postgres

# ── Email OTP (Gmail SMTP) ────────────────────────────────────────────────────
# 1. Enable 2-Step Verification on your Google account
# 2. Go to https://myaccount.google.com/apppasswords → generate App Password for "Mail"
# 3. Paste the 16-char password below (no spaces)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your_16char_gmail_app_password
SMTP_FROM_NAME=VentureRoot
SMTP_FROM_EMAIL=you@gmail.com

# ── SMS OTP (Termii / Infobip / Mock) ──────────────────────────────────────────
# SMS_PROVIDER=mock    → logs OTP code to Docker stdout (default when no provider key is set)
# SMS_PROVIDER=termii  → sends real SMS via Termii (requires TERMII_API_KEY)
# SMS_PROVIDER=infobip → sends real SMS via Infobip (requires INFOBIP_API_KEY + INFOBIP_BASE_URL)
SMS_PROVIDER=mock

# Termii — get your key at: https://termii.com → Settings → API Key & Webhooks
TERMII_API_KEY=your_termii_api_key_here
TERMII_SENDER_ID=N-Alert   # generic sender pre-approved for all NG numbers
TERMII_CHANNEL=generic     # 'generic' works without DND registration

# Infobip — API key and base URL are both shown together on your Infobip
# portal homepage (https://portal.infobip.com/homepage); base URL is
# account-specific (e.g. https://xxxxxx.api.infobip.com), no shared default.
INFOBIP_API_KEY=your_infobip_api_key_here
INFOBIP_BASE_URL=
INFOBIP_SENDER_ID=

# ── Worker module security ─────────────────────────────────────────────────────
# No default is set on purpose — the endpoints fail closed (503/403) until these
# are configured, rather than accept a guessable committed default.
# PAYMENT_WEBHOOK_SECRET: shared HMAC secret with your payment provider for
#   POST /v1/worker/payments/webhook (verifies the X-Webhook-Signature header).
# WORKER_CRON_SECRET: shared secret your scheduler sends as X-Cron-Secret when
#   calling POST /v1/worker/investments/accrue-dividends — this runs platform-wide
#   for every investor and must never be reachable from a mobile session.
PAYMENT_WEBHOOK_SECRET=generate_a_long_random_secret_here
WORKER_CRON_SECRET=generate_a_different_long_random_secret_here
