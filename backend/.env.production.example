# Production Environment - 2M User Scale Configuration
# Copy this file to .env.production and fill in real values via your secrets
# manager (AWS Secrets Manager, K8s Secrets, etc.) — never commit .env.production.

ENV=production
LOG_LEVEL=info
DEBUG=false

# ============================================
# SUPABASE (auth identity — core-banking owns business/financial data)
# ============================================
# SUPABASE_SERVICE_KEY must be the service_role secret, never the anon key.
# Required for password_reset.py's confirm step, which sets a user's
# Supabase Auth password directly via the Admin API — there's no logged-in
# session to update it through the normal client-side path when a user has
# forgotten their password.
SUPABASE_URL=CHANGE_ME_IN_PRODUCTION
SUPABASE_SERVICE_KEY=CHANGE_ME_IN_PRODUCTION

# ============================================
# DATABASE CONFIGURATION (Production Optimized)
# ============================================
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ventureroot
POSTGRES_USER=ventureroot
POSTGRES_PASSWORD=CHANGE_ME_IN_PRODUCTION

# Connection pooling for 2M users
DB_POOL_SIZE=50
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=3600

# ============================================
# REDIS CONFIGURATION (High Availability)
# ============================================
# REDIS_PASSWORD is required — docker-compose-production.yml refuses to start
# Redis without it (--requirepass) and no longer publishes 6379 to the host,
# so it's only reachable by other containers on the backend network.
# REDIS_PASSWORD also needs to be set in backend/.env (not this file) — that's
# the file docker-compose itself reads for ${REDIS_PASSWORD} substitution
# inside docker-compose-production.yml, same as POSTGRES_PASSWORD above.
# core-banking and api-gateway get their authenticated REDIS_URL injected
# directly by the compose file's environment: block, which overrides the
# plain value below — only relevant here if you deploy those services some
# other way (e.g. Kubernetes) and need the literal connection string.
REDIS_PASSWORD=CHANGE_ME_IN_PRODUCTION
REDIS_URL=redis://:CHANGE_ME_IN_PRODUCTION@redis:6379/0
REDIS_SENTINEL_ENABLED=false  # Enable in multi-region setup
REDIS_CLUSTER_ENABLED=false   # Enable for sharding

# ============================================
# JWT AUTHENTICATION
# ============================================
JWT_ISSUER=ventureroot
JWT_AUDIENCE=ventureroot-mobile
JWT_SECRET=CHANGE_ME_IN_PRODUCTION
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# ============================================
# INTERNAL SERVICE DISCOVERY (Docker network)
# ============================================
CORE_BANKING_URL=http://core-banking:8001
AI_ML_URL=http://ai-ml-service:8002
RAG_URL=http://rag-service:8003
USSD_URL=http://ussd-service:8004

# Service timeouts (seconds)
SERVICE_REQUEST_TIMEOUT=30
SERVICE_POOL_CONNECTIONS=20

# ============================================
# API RATE LIMITING & SECURITY
# ============================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=1000
RATE_LIMIT_PERIOD=60

CORS_ORIGINS=https://example.com,https://app.example.com
ALLOWED_HOSTS=*

# ============================================
# AI/ML SERVICE CONFIGURATION
# ============================================
OPENAI_API_KEY=CHANGE_ME_IN_PRODUCTION
OPENAI_MODEL=gpt-4-turbo
OPENAI_TIMEOUT=30

# Google Generative AI for RAG
GOOGLE_API_KEY=CHANGE_ME_IN_PRODUCTION

# ============================================
# RAG ENGINE CONFIGURATION (Voice + Document)
# ============================================
RAG_ENABLED=true
RAG_CACHE_TTL=3600
RAG_MAX_DOCUMENTS=10000
RAG_EMBEDDING_MODEL=text-embedding-3-small

# Speech Recognition
SPEECH_RECOGNITION_SERVICE=google  # or 'openai'
SPEECH_LANG=en-US

# ============================================
# SMS OTP (Termii / Infobip / Mock)
# ============================================
# 'mock' logs to stdout only — never use in production once a real number
# needs to receive a code (password reset, phone verification).
SMS_PROVIDER=infobip
TERMII_API_KEY=
TERMII_SENDER_ID=N-Alert
TERMII_CHANNEL=generic
# Infobip: API key + base URL are both on your portal homepage
# (https://portal.infobip.com/homepage) — base URL is account-specific,
# there's no shared default.
INFOBIP_API_KEY=CHANGE_ME_IN_PRODUCTION
INFOBIP_BASE_URL=CHANGE_ME_IN_PRODUCTION
INFOBIP_SENDER_ID=

# ============================================
# FEATURE FLAGS (Production)
# ============================================
SOLID_PRINCIPLES=true
TYPE_SAFETY=true
WITH_TESTS=true
PERF_AUDIT=true
SECURITY_HARDENED=true
PRODUCTION_ONLY=true

# ============================================
# MONITORING & OBSERVABILITY
# ============================================
SENTRY_DSN=CHANGE_ME_IN_PRODUCTION
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090

# ============================================
# STORAGE (S3-compatible for files)
# ============================================
S3_BUCKET=ventureroot-prod
S3_REGION=us-east-1
S3_ACCESS_KEY=CHANGE_ME_IN_PRODUCTION
S3_SECRET_KEY=CHANGE_ME_IN_PRODUCTION
S3_ENDPOINT=https://s3.amazonaws.com

# ============================================
# BACKGROUND JOBS (Celery)
# ============================================
CELERY_BROKER_URL=redis://:CHANGE_ME_IN_PRODUCTION@redis:6379/1
CELERY_RESULT_BACKEND=redis://:CHANGE_ME_IN_PRODUCTION@redis:6379/2
CELERY_TASK_SERIALIZER=json
CELERY_ACCEPT_CONTENT=json
CELERY_RESULT_EXPIRES=3600

# ============================================
# CACHE CONFIGURATION
# ============================================
CACHE_TTL_SHORT=300      # 5 minutes for frequently changing data
CACHE_TTL_MEDIUM=1800    # 30 minutes for moderately changing data
CACHE_TTL_LONG=86400     # 24 hours for stable data

# ============================================
# AUTO-SCALING PARAMETERS (Kubernetes)
# ============================================
TARGET_CPU_UTILIZATION=70
TARGET_MEMORY_UTILIZATION=75
HPA_MIN_REPLICAS=3
HPA_MAX_REPLICAS=20
HPA_SCALE_DOWN_STABILIZATION=300

# ============================================
# ASYNC PROCESSING
# ============================================
ASYNC_TASK_TIMEOUT=300
ASYNC_RETRY_ATTEMPTS=3
ASYNC_RETRY_DELAY=60
