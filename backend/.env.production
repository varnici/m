# Production Environment - 2M User Scale Configuration
# DO NOT commit sensitive values; use secrets management in production (AWS Secrets Manager, K8s Secrets, etc.)

ENV=production
LOG_LEVEL=info
DEBUG=false

# ============================================
# DATABASE CONFIGURATION (Production Optimized)
# ============================================
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ventureroot
POSTGRES_USER=ventureroot
POSTGRES_PASSWORD=CHANGE_ME_IN_PRODUCTION

# Connection pooling for 2M users
DB_POOL_SIZE=50
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=3600

# ============================================
# REDIS CONFIGURATION (High Availability)
# ============================================
REDIS_URL=redis://redis:6379/0
REDIS_SENTINEL_ENABLED=false  # Enable in multi-region setup
REDIS_CLUSTER_ENABLED=false   # Enable for sharding

# ============================================
# JWT AUTHENTICATION
# ============================================
JWT_ISSUER=ventureroot
JWT_AUDIENCE=ventureroot-mobile
JWT_SECRET=CHANGE_ME_IN_PRODUCTION
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# ============================================
# INTERNAL SERVICE DISCOVERY (Docker network)
# ============================================
CORE_BANKING_URL=http://core-banking:8001
AI_ML_URL=http://ai-ml-service:8002
RAG_URL=http://rag-service:8003
USSD_URL=http://ussd-service:8004

# Service timeouts (seconds)
SERVICE_REQUEST_TIMEOUT=30
SERVICE_POOL_CONNECTIONS=20

# ============================================
# API RATE LIMITING & SECURITY
# ============================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=1000
RATE_LIMIT_PERIOD=60

CORS_ORIGINS=https://example.com,https://app.example.com
ALLOWED_HOSTS=*

# ============================================
# AI/ML SERVICE CONFIGURATION
# ============================================
OPENAI_API_KEY=CHANGE_ME_IN_PRODUCTION
OPENAI_MODEL=gpt-4-turbo
OPENAI_TIMEOUT=30

# Google Generative AI for RAG
GOOGLE_API_KEY=CHANGE_ME_IN_PRODUCTION

# ============================================
# RAG ENGINE CONFIGURATION (Voice + Document)
# ============================================
RAG_ENABLED=true
RAG_CACHE_TTL=3600
RAG_MAX_DOCUMENTS=10000
RAG_EMBEDDING_MODEL=text-embedding-3-small

# Speech Recognition
SPEECH_RECOGNITION_SERVICE=google  # or 'openai'
SPEECH_LANG=en-US

# ============================================
# FEATURE FLAGS (Production)
# ============================================
SOLID_PRINCIPLES=true
TYPE_SAFETY=true
WITH_TESTS=true
PERF_AUDIT=true
SECURITY_HARDENED=true
PRODUCTION_ONLY=true

# ============================================
# MONITORING & OBSERVABILITY
# ============================================
SENTRY_DSN=CHANGE_ME_IN_PRODUCTION
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090

# ============================================
# STORAGE (S3-compatible for files)
# ============================================
S3_BUCKET=ventureroot-prod
S3_REGION=us-east-1
S3_ACCESS_KEY=CHANGE_ME_IN_PRODUCTION
S3_SECRET_KEY=CHANGE_ME_IN_PRODUCTION
S3_ENDPOINT=https://s3.amazonaws.com

# ============================================
# BACKGROUND JOBS (Celery)
# ============================================
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
CELERY_TASK_SERIALIZER=json
CELERY_ACCEPT_CONTENT=json
CELERY_RESULT_EXPIRES=3600

# ============================================
# CACHE CONFIGURATION
# ============================================
CACHE_TTL_SHORT=300      # 5 minutes for frequently changing data
CACHE_TTL_MEDIUM=1800    # 30 minutes for moderately changing data
CACHE_TTL_LONG=86400     # 24 hours for stable data

# ============================================
# AUTO-SCALING PARAMETERS (Kubernetes)
# ============================================
TARGET_CPU_UTILIZATION=70
TARGET_MEMORY_UTILIZATION=75
HPA_MIN_REPLICAS=3
HPA_MAX_REPLICAS=20
HPA_SCALE_DOWN_STABILIZATION=300

# ============================================
# ASYNC PROCESSING
# ============================================
ASYNC_TASK_TIMEOUT=300
ASYNC_RETRY_ATTEMPTS=3
ASYNC_RETRY_DELAY=60
