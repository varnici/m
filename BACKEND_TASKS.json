          "service": "core-banking",
          "file_path": "backend/services/core-banking/app/api/v1/endpoints/loans.py",
          "type": "api_endpoint",
          "dependencies": ["T2.1"],
          "endpoints": [
            {
              "method": "GET",
              "path": "/v1/loans/{user_id}",
              "description": "Get active and recent loans",
              "response": {
                "available_credit": "int",
                "credit_in_use": "int",
                "active_loans": [
                  {
                    "id": "uuid",
                    "product_name": "Dangote Flour Pool",
                    "loan_amount": "int",
                    "outstanding": "int",
                    "status": "Active",
                    "due_date": "date",
                    "insured": true,
                    "icon": "🌾"
                  }
                ],
                "loan_history": [
                  {
                    "id": "uuid",
                    "product_name": "Indomie Noodles",
                    "month": "Nov 2024",
                    "amount": "int",
                    "status": "Paid"
                  }
                ]
              }
            },
            {
              "method": "GET",
              "path": "/v1/loans/{loan_id}/contract",
              "description": "Fetch contract PDF/document",
              "response": "pdf_document"
            }
          ],
          "acceptance_criteria": [
            "Returns active loans with correct fields",
            "Returns historical loans",
            "Contract endpoint returns valid document"
          ],
          "status": "completed",
          "effort_hours": 5
        },
        {
          "id": "T2.4",
          "title": "Implement Loan Repayment Processing",
          "description": "Process repayment, update wallet, record transaction, update credit score",
          "service": "core-banking",
          "file_path": "backend/services/core-banking/app/services/repayment_service.py",
          "type": "service + endpoint",
          "dependencies": ["T2.2", "T1.4"],
          "implementation": {
            "endpoint": "POST /v1/loans/{loan_id}/repay",
            "payload": {
              "amount_kobo": "int",
              "payment_method": "string"
            },
            "process": [
              "1. Validate loan exists and user owns it",
              "2. Validate amount <= outstanding",
              "3. Deduct from wallet.current_balance_kobo",
              "4. Create Repayment record",
              "5. If loan fully repaid, update loan.status = 'closed'",
              "6. Create Transaction record (debit)",
              "7. Recalculate CreditScore (repayment_consistency)",
              "8. Return success response"
            ]
          },
          "acceptance_criteria": [
            "Repayment recorded correctly",
            "Wallet balance updated",
            "Transaction created",
            "Credit score recalculated",
            "Closed loan marked as 'closed'"
          ],
          "status": "completed",
          "effort_hours": 5
        }
      ]
