{
  "project": "VentureRoot Backend - Dashboard Pipeline",
  "version": "1.0",
  "created_at": "2024-12-15",
  "status": "Planning",
  "phases": [
    {
      "id": "PHASE_1A",
      "name": "Critical Dashboard Data - Core Models",
      "description": "Build foundational models and services for dashboard",
      "timeline_days": 5,
      "priority": "CRITICAL",
      "tasks": [
        {
          "id": "T1.1",
          "title": "Expand User Model with Business Profile Fields",
          "description": "Add business_name, trading_name, category, ownership_type, registration_status, location fields",
          "service": "core-banking",
          "file_path": "backend/services/core-banking/app/models/user.py",
          "type": "database_migration",
          "dependencies": [],
          "data_structure": {
            "model": "User",
            "new_fields": [
              { "name": "business_name", "type": "String", "required": true },
              { "name": "trading_name", "type": "String", "required": false },
              { "name": "primary_category", "type": "String", "required": true },
              { "name": "years_in_operation", "type": "Integer", "required": true },
              { "name": "ownership_type", "type": "Enum('Rented','Owned','Mobile')", "required": true },
              { "name": "registration_status", "type": "Enum('Registered','Not Registered')", "required": true },
              { "name": "location_state", "type": "String", "required": true },
              { "name": "location_lga", "type": "String", "required": true },
              { "name": "location_address", "type": "String", "required": true },
              { "name": "avatar_initials", "type": "String", "required": false }
            ]
          },
          "acceptance_criteria": [
            "Migration runs without errors",
            "Existing users updated to onboarding data",
            "API returns all fields"
          ],
          "status": "completed",
          "effort_hours": 3
        },
        {
          "id": "T1.2",
          "title": "Create Wallet Model & Initial Balance",
          "description": "Create Wallet table with balance, credit limit, and daily change tracking",
          "service": "core-banking",
          "file_path": "backend/services/core-banking/app/models/wallet.py",
          "type": "database_model",
          "dependencies": ["T1.1"],
          "data_structure": {
            "model": "Wallet",
            "fields": [
              { "name": "id", "type": "UUID", "pk": true },
              { "name": "user_id", "type": "UUID", "fk": "users.id" },
              { "name": "current_balance_kobo", "type": "BigInteger", "default": 0 },
              { "name": "daily_change_kobo", "type": "BigInteger", "default": 0 },
              { "name": "available_credit_kobo", "type": "BigInteger", "default": 0 },
              { "name": "credit_in_use_kobo", "type": "BigInteger", "default": 0 },
              { "name": "credit_limit_kobo", "type": "BigInteger", "computed_from": "credit_in_use + available_credit" },
              { "name": "next_repayment_date", "type": "Date", "nullable": true },
              { "name": "next_repayment_amount_kobo", "type": "BigInteger", "nullable": true },
              { "name": "created_at", "type": "Timestamp" },
              { "name": "updated_at", "type": "Timestamp" }
            ]
          },
          "acceptance_criteria": [
            "Wallet table created with all fields",
            "Index on user_id",
            "GET /v1/wallet/{user_id} returns correct structure"
          ],
          "status": "completed",
          "effort_hours": 4
        },
        {
          "id": "T1.3",
          "title": "Create SalesMetrics Model & Aggregation",
          "description": "Create SalesMetrics table for daily sales rollup with tax calculation",
          "service": "core-banking",
          "file_path": "backend/services/core-banking/app/models/sales_metrics.py",
          "type": "database_model + service",
          "dependencies": [],
          "data_structure": {
            "model": "SalesMetrics",
            "fields": [
              { "name": "id", "type": "UUID", "pk": true },
              { "name": "user_id", "type": "UUID", "fk": "users.id" },
              { "name": "date", "type": "Date", "unique_with": "user_id" },
              { "name": "total_sales_amount_kobo", "type": "BigInteger" },
              { "name": "num_transactions", "type": "Integer" },
              { "name": "avg_transaction_value_kobo", "type": "BigInteger" },
              { "name": "total_units_sold", "type": "Integer" },
              { "name": "vs_yesterday_percent", "type": "Float" },
              { "name": "total_taxable_amount_kobo", "type": "BigInteger" },
              { "name": "tax_liability_kobo", "type": "BigInteger", "computed": "total_taxable * 0.075" },
              { "name": "created_at", "type": "Timestamp" }
            ]
          },
          "service_methods": [
            {
              "name": "calculate_daily_rollup",
              "signature": "def calculate_daily_rollup(user_id: str, date: date) -> SalesMetrics",
              "logic": "Sum all sales for date, compute metrics from Sale records"
            },
            {
              "name": "calculate_tax_liability",
              "signature": "def calculate_tax_liability(total_sales: int) -> int",
              "logic": "Return 7.5% of total_sales"
            },
            {
              "name": "get_today_summary",
              "signature": "def get_today_summary(user_id: str) -> dict",
              "logic": "Query SalesMetrics for today, format for dashboard"
            }
          ],
          "acceptance_criteria": [
            "SalesMetrics table created",
            "Daily rollup job populates correctly",
            "GET /v1/sales/{user_id}/today returns correct format",
            "Tax calculation verified (7.5% VAT)"
          ],
          "status": "completed",
          "effort_hours": 5
        },
        {
          "id": "T1.4",
          "title": "Create CreditScore Model & Calculation Engine",
          "description": "Calculate credit score based on 4 drivers: sales velocity, repayment, category risk, income stability",
          "service": "core-banking",
          "file_path": "backend/services/core-banking/app/models/credit_score.py",
          "type": "database_model + complex service",
          "dependencies": ["T1.3"],
          "data_structure": {
            "model": "CreditScore",
            "fields": [
              { "name": "id", "type": "UUID", "pk": true },
              { "name": "user_id", "type": "UUID", "fk": "users.id" },
              { "name": "total_score", "type": "Integer", "range": "0-1000" },
              { "name": "tier", "type": "Enum('Bronze','Silver','Gold','Platinum')" },
              { "name": "sales_velocity_score", "type": "Integer", "weight": "35%" },
              { "name": "repayment_consistency_score", "type": "Integer", "weight": "30%" },
              { "name": "category_risk_score", "type": "Integer", "weight": "20%" },
              { "name": "income_stability_score", "type": "Integer", "weight": "15%" },
              { "name": "calculated_at", "type": "Timestamp" },
              { "name": "valid_until", "type": "Timestamp" },
              { "name": "confidence_level", "type": "Float", "range": "0.0-1.0" }
            ],
            "tier_mapping": {
              "0-250": "Bronze",
              "250-500": "Silver",
              "500-750": "Gold",
              "750-1000": "Platinum"
            }
          },
          "service_methods": [
            {
              "name": "calculate_credit_score",
              "signature": "def calculate_credit_score(user_id: str) -> CreditScore",
              "logic": "Aggregate 4 driver scores with weights, store new record, return"
            },
            {
              "name": "calculate_sales_velocity_score",
              "signature": "def calculate_sales_velocity_score(user_id: str) -> int",
              "logic": "7-day avg / 30-day avg velocity, normalize to 0-100"
            },
            {
              "name": "calculate_repayment_score",
              "signature": "def calculate_repayment_score(user_id: str) -> int",
              "logic": "on_time_repayments / total_repayments * 100"
            },
            {
              "name": "calculate_category_risk",
              "signature": "def calculate_category_risk(category: str) -> int",
              "logic": "Lookup risk matrix for category, return score"
            },
            {
              "name": "calculate_income_stability",
              "signature": "def calculate_income_stability(user_id: str) -> int",
              "logic": "Std dev of daily sales / mean, inverse to stability score"
            }
          ],
          "acceptance_criteria": [
            "Score calculation matches specification",
            "Tier assignment correct per thresholds",
            "GET /v1/credit-score/{user_id} returns full breakdown",
            "Scores tested against sample data"
          ],
          "status": "completed",
          "effort_hours": 8
        },
        {
          "id": "T1.5",
          "title": "Create Transaction Model & Activity Log",
          "description": "Create Transaction table for activity stream (sales, repayments, disbursements)",
          "service": "core-banking",
          "file_path": "backend/services/core-banking/app/models/transaction.py",
          "type": "database_model",
          "dependencies": [],
          "data_structure": {
            "model": "Transaction",
            "fields": [
              { "name": "id", "type": "UUID", "pk": true },
              { "name": "user_id", "type": "UUID", "fk": "users.id" },
              { "name": "type", "type": "Enum('sale_proceeds','repayment_sweep','loan_disbursement','transfer_out','other')" },
              { "name": "amount_kobo", "type": "BigInteger" },
              { "name": "direction", "type": "Enum('credit','debit','loan')" },
              { "name": "description", "type": "String" },
              { "name": "metadata", "type": "JSON", "nullable": true },
              { "name": "created_at", "type": "Timestamp", "pk_order": 2 }
            ]
          },
          "acceptance_criteria": [
            "Transaction table created",
            "Indexes on (user_id, created_at DESC)",
            "GET /v1/transactions/{user_id}/recent returns items sorted by time"
          ],
          "status": "not-started",
          "effort_hours": 3
        },
        {
          "id": "T1.6",
          "title": "Implement DashboardDataService (Orchestration)",
          "description": "Create service to fetch all dashboard data in single call to reduce N+1 queries",
          "service": "api-gateway",
          "file_path": "backend/services/api-gateway/app/services/dashboard_service.py",
          "type": "service layer",
          "dependencies": ["T1.2", "T1.3", "T1.4", "T1.5"],
          "implementation": {
            "method": "get_dashboard_summary",
            "signature": "async def get_dashboard_summary(user_id: str) -> dict",
            "calls": [
              { "service": "core-banking", "endpoint": "/v1/users/{user_id}/profile" },
              { "service": "core-banking", "endpoint": "/v1/wallet/{user_id}" },
              { "service": "core-banking", "endpoint": "/v1/credit-score/{user_id}" },
              { "service": "core-banking", "endpoint": "/v1/sales/{user_id}/today" },
              { "service": "core-banking", "endpoint": "/v1/transactions/{user_id}/recent?limit=5" },
              { "service": "rag-service", "endpoint": "/v1/intelligence/market-ticker" },
              { "service": "rag-service", "endpoint": "/v1/intelligence/articles?category=for-you&limit=3" }
            ],
            "response_shape": {
              "user": "UserProfile",
              "wallet": "WalletState",
              "credit_score": "CreditScoreDetail",
              "today_sales": "SalesMetrics",
              "recent_activity": "Transaction[]",
              "market_ticker": "MarketTicker[]",
              "intelligence": "IntelligenceArticle[]"
            }
          },
          "acceptance_criteria": [
            "Single API call returns all dashboard data",
            "Parallel requests to reduce latency",
            "Response time < 500ms (cached where possible)",
            "Error handling for individual service failures"
          ],
          "status": "completed",
          "effort_hours": 6
        }
      ]
    },
    {
